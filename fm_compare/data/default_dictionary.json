  "kpi_dictionary": [
    {"name": "Выручка", "group": "Продажи", "level": 1, "unit": "руб.", "better_direction": "up", "search_pattern": "выручк|revenue|^продажи?$|итого.*продаж|продажи.{0,10}итого", "search_in": "row_label"},
    {"name": "Поступления денежных средств", "group": "Денежный поток", "level": 1, "unit": "руб.", "better_direction": "up", "search_pattern": "поступлени|cash.{0,10}in|приход", "search_in": "row_label"},
    {"name": "Себестоимость / CAPEX / СМР", "group": "Затраты", "level": 1, "unit": "руб.", "better_direction": "down", "search_pattern": "себестоим|capex|смр|строительств", "search_in": "row_label"},
    {"name": "Прочие расходы", "group": "Затраты", "level": 1, "unit": "руб.", "better_direction": "down", "search_pattern": "прочие.{0,10}расход|проч.расх", "search_in": "row_label"},
    {"name": "Налоги", "group": "Налоги", "level": 1, "unit": "руб.", "better_direction": "neutral", "search_pattern": "налог|tax", "search_in": "row_label"},
    {"name": "Процентные расходы", "group": "Финансирование", "level": 1, "unit": "руб.", "better_direction": "down", "search_pattern": "процент.{0,10}расход|interest.{0,10}exp", "search_in": "row_label"},
    {"name": "Финансирование / потребность", "group": "Финансирование", "level": 1, "unit": "руб.", "better_direction": "down", "search_pattern": "финансирован|потребност.{0,10}финанс", "search_in": "row_label"},
    {"name": "Денежный поток", "group": "Денежный поток", "level": 1, "unit": "руб.", "better_direction": "up", "search_pattern": "денежн.{0,10}поток|cash.{0,10}flow|cf итог", "search_in": "row_label"},
    {"name": "Cash gap / минимальный остаток", "group": "Денежный поток", "level": 1, "unit": "руб.", "better_direction": "up", "search_pattern": "cash.gap|мин.{0,10}остат|кассов.{0,10}разрыв", "search_in": "row_label"},
    {"name": "Прибыль проекта", "group": "Доходность", "level": 1, "unit": "руб.", "better_direction": "up", "search_pattern": "прибыл.{0,10}проект|чист.{0,10}прибыл", "search_in": "row_label"},
    {"name": "Маржинальность", "group": "Доходность", "level": 1, "unit": "%", "better_direction": "up", "search_pattern": "маржинальн|margin", "search_in": "row_label"},
    {"name": "IRR", "group": "Доходность", "level": 1, "unit": "%", "better_direction": "up", "search_pattern": "\\birr\\b|внутрен.{0,10}норм", "search_in": "row_label"},
    {"name": "NPV", "group": "Доходность", "level": 1, "unit": "руб.", "better_direction": "up", "search_pattern": "\\bnpv\\b|чист.{0,10}привед", "search_in": "row_label"},
    {"name": "Вложения инвесторов / акционеров", "group": "Финансирование", "level": 1, "unit": "руб.", "better_direction": "down", "search_pattern": "вложен.{0,10}инвест|вклад.{0,10}акцион", "search_in": "row_label"},
    {"name": "Возврат инвесторам / дивиденды", "group": "Финансирование", "level": 1, "unit": "руб.", "better_direction": "up", "search_pattern": "возврат.{0,10}инвест|дивиденд", "search_in": "row_label"},
    {"name": "Площадь продаваемая", "group": "Продажи", "level": 1, "unit": "кв.м", "better_direction": "up", "search_pattern": "площад.{0,10}прод|sell.{0,10}area", "search_in": "row_label"},
    {"name": "Средняя цена реализации", "group": "Продажи", "level": 2, "unit": "руб./кв.м", "better_direction": "up", "search_pattern": "сред.{0,10}цен|avg.{0,10}price", "search_in": "row_label"},
    {"name": "Сроки продаж", "group": "Продажи", "level": 2, "unit": "дата", "better_direction": "neutral", "search_pattern": "срок.{0,10}продаж|дата.{0,10}начал.{0,10}продаж", "search_in": "row_label"},
    {"name": "Сроки поступлений", "group": "Денежный поток", "level": 2, "unit": "дата", "better_direction": "up", "search_pattern": "срок.{0,10}поступл|дата.{0,10}поступл", "search_in": "row_label"},
    {"name": "Срок ввода / завершения проекта", "group": "Проект", "level": 2, "unit": "дата", "better_direction": "neutral", "search_pattern": "срок.{0,10}ввод|завершен.{0,10}проект|ввод.{0,10}экспл", "search_in": "row_label"}
  ],
  "business_key_rules": [
    {
      "group": "Итоговые показатели",
      "key_strategy": "row_label_col_b",
      "label_col": 2,
      "key_cols": [2],
      "strip_chars": " \t\n",
      "normalize_case": true
    },
    {
      "group": "default",
      "key_strategy": "row_label_col_b",
      "label_col": 2,
      "key_cols": [2],
      "strip_chars": " \t\n",
      "normalize_case": true
    }
  ],
  "materiality_rules": {
    "default": {"abs_threshold": null, "pct_threshold": null},
    "Итоговые показатели": {"abs_threshold": 1000000, "pct_threshold": 1.0},
    "Продажи": {"abs_threshold": 500000, "pct_threshold": 0.5},
    "Денежный поток": {"abs_threshold": 1000000, "pct_threshold": 1.0},
    "Доходность": {"abs_threshold": null, "pct_threshold": 0.5},
    "Затраты": {"abs_threshold": 1000000, "pct_threshold": 1.0},
    "Финансирование": {"abs_threshold": 1000000, "pct_threshold": 1.0},
    "Налоги": {"abs_threshold": 500000, "pct_threshold": 1.0}
  },
  "synonyms": {
    "выручка": ["revenue", "revenues", "продажи итого", "total sales"],
    "прибыль": ["profit", "net profit", "чистая прибыль"],
    "денежный поток": ["cash flow", "cf", "поток денежных средств"],
    "финансирование": ["financing", "finance"],
    "себестоимость": ["cost of sales", "cogs", "себест"],
    "инвесторы": ["investors", "investor"],
    "налоги": ["tax", "taxes", "налоговые"],
    "поступления": ["receipts", "cash in", "приходы"],
    "площадь": ["area", "площ"],
    "цена": ["price", "стоимость кв.м"]
  },
  "sensitivity_inputs": [
    {
      "name": "Цена реализации (руб./кв.м)",
      "unit": "руб./кв.м",
      "search_sheet_pattern": "PRICE|ПРАЙС",
      "search_row_pattern": "цена.{0,15}реализ|средн.{0,10}цена|price.{0,10}m2|price.{0,10}sqm",
      "default_step_pct": 10
    },
    {
      "name": "Площадь продаваемая (кв.м)",
      "unit": "кв.м",
      "search_sheet_pattern": "SALE|ПРОД|ПРОДАЖ",
      "search_row_pattern": "площад.{0,10}прод|sell.{0,10}area|total.{0,10}area",
      "default_step_pct": 10
    },
    {
      "name": "Стоимость СМР (руб.)",
      "unit": "руб.",
      "search_sheet_pattern": "COST|ДЕТАЛИ|DETAILS|СМР",
      "search_row_pattern": "5400|генподряд|смр.{0,10}итого|итого.{0,10}смр",
      "default_step_pct": 10
    },
    {
      "name": "Ставка финансирования (%)",
      "unit": "%",
      "search_sheet_pattern": "FINANCE|ФИНАНС|Расчет %",
      "search_row_pattern": "ставк.{0,10}кредит|ставк.{0,10}финанс|interest.{0,10}rate",
      "default_step_pct": 20
    }
  ],
  "warning_rules": [
    {"type": "formula_changed_value_same", "severity": "medium", "message": "Изменена логика формулы, значение не изменилось", "manual_check": true},
    {"type": "sign_changed", "severity": "high", "message": "Изменился знак показателя", "manual_check": true},
    {"type": "kpi_not_found", "severity": "high", "message": "KPI уровня 1 не найден", "manual_check": true},
    {"type": "not_matched", "severity": "medium", "message": "Строка не сопоставлена", "manual_check": false},
    {"type": "fuzzy_match", "severity": "low", "message": "Нечёткое сопоставление", "manual_check": false},
    {"type": "partial_dependency", "severity": "medium", "message": "Частичная трассировка зависимостей", "manual_check": true},
    {"type": "sheet_missing", "severity": "high", "message": "Лист отсутствует в одной из версий", "manual_check": true},
    {"type": "excluded_sheet_affects_kpi", "severity": "medium", "message": "Исключённый лист влияет на KPI", "manual_check": true}
  ]
}
