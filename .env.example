# Gateway / LLM + web service configuration for FM Compare.
#
# Copy this file to `.env` (which is gitignored) and fill in your credentials.
# NEVER commit the real .env. The frontend/app must not store a shared bearer
# token — credentials here are used to fetch a fresh Keycloak access token
# before each gateway call.

# --- Web service access ---
# Single shared password protecting the whole site. If empty, the service is
# UNPROTECTED (only acceptable for local dev). Set a strong value on the VM.
APP_PASSWORD=
# Optional: stable secret for signing the session cookie. If empty, a random
# per-process secret is used (sessions reset on restart).
APP_SECRET=

# --- Gateway (OpenAI-compatible) ---
GATEWAY_BASE_URL=http://BA-SRV-AI-APP01.mr-group.ru:8080

# --- Keycloak (realm AI-Gateway, password grant) ---
KEYCLOAK_TOKEN_URL=https://key.mr-group.ru/realms/AI-Gateway/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=ai-gateway
KEYCLOAK_USERNAME=
KEYCLOAK_PASSWORD=

# --- Model selection ---
# Must be a model id visible to your role via GET /v1/models.
# Available at time of writing:
#   deepseek/deepseek-v4-flash
#   deepseek/deepseek-v4-pro
#   llm                      (local Qwen inside the company perimeter)
#   openai/gpt-4.1
#   openai/gpt-5.4
#   openai/gpt-5.5
LLM_MODEL=openai/gpt-5.5

# --- Optional ---
# Per-request timeout in seconds (default 120).
LLM_TIMEOUT_S=120
